; Golden tests for the generated Dockerfiles.  Dist and Dockerfile_gen are
; copied from bin/ rather than shared through a library so that bin/ stays a
; single executable; the copy keeps the tests honest because it is the same
; source.

(executable
 (name dump)
 (modules dump dockerfile_gen dist)
 (libraries dockerfile dockerfile-opam ocaml-version))

(copy_files#
 (files ../bin/dockerfile_gen.ml))

(copy_files#
 (files ../bin/dist.ml))

(rule
 (with-stdout-to
  debian-13.Dockerfile.actual
  (run ./dump.exe debian 13 debian)))

(rule
 (with-stdout-to
  fedora-42.Dockerfile.actual
  (run ./dump.exe fedora 42 fedora)))

(rule
 (with-stdout-to
  alpine-3.22.Dockerfile.actual
  (run ./dump.exe alpine 3.22 alpine)))

(rule
 (with-stdout-to
  opensuse-15.6.Dockerfile.actual
  (run ./dump.exe opensuse 15.6 suse)))

(rule
 (with-stdout-to
  archlinux.Dockerfile.actual
  (run ./dump.exe archlinux latest arch)))

(rule
 (alias runtest)
 (action
  (diff debian-13.Dockerfile debian-13.Dockerfile.actual)))

(rule
 (alias runtest)
 (action
  (diff fedora-42.Dockerfile fedora-42.Dockerfile.actual)))

(rule
 (alias runtest)
 (action
  (diff alpine-3.22.Dockerfile alpine-3.22.Dockerfile.actual)))

(rule
 (alias runtest)
 (action
  (diff opensuse-15.6.Dockerfile opensuse-15.6.Dockerfile.actual)))

(rule
 (alias runtest)
 (action
  (diff archlinux.Dockerfile archlinux.Dockerfile.actual)))
