; Golden tests for the generated Dockerfiles.  A change to the generator shows
; up as a diff here rather than silently altering the images day10 builds.

(executable
 (name dump)
 (modules dump)
 (libraries day10 dockerfile))

; Assertions over the parts that need neither a container nor a repository.

(executable
 (name unit)
 (modules unit)
 (libraries day10 opam-format unix))

(rule
 (alias runtest)
 (action
  (run ./unit.exe)))

; The command line itself, driven against fixture caches and repositories.

(cram
 (applies_to cache solver project)
 (deps %{bin:day10}))

; Tests that drive a real container.  Held out of runtest because they need
; runc, sudo, a base image and a warm cache: run them with dune build @container
; on a builder that has them.

(cram
 (applies_to container)
 (alias container)
 (runtest_alias false)
 (deps %{bin:day10}))

(rule
 (with-stdout-to
  debian-13.Dockerfile.actual
  (run ./dump.exe debian 13 debian)))

(rule
 (with-stdout-to
  fedora-42.Dockerfile.actual
  (run ./dump.exe fedora 42 fedora)))

(rule
 (with-stdout-to
  alpine-3.22.Dockerfile.actual
  (run ./dump.exe alpine 3.22 alpine)))

(rule
 (with-stdout-to
  opensuse-15.6.Dockerfile.actual
  (run ./dump.exe opensuse 15.6 suse)))

(rule
 (with-stdout-to
  archlinux.Dockerfile.actual
  (run ./dump.exe archlinux latest arch)))

(rule
 (alias runtest)
 (action
  (diff debian-13.Dockerfile debian-13.Dockerfile.actual)))

(rule
 (alias runtest)
 (action
  (diff fedora-42.Dockerfile fedora-42.Dockerfile.actual)))

(rule
 (alias runtest)
 (action
  (diff alpine-3.22.Dockerfile alpine-3.22.Dockerfile.actual)))

(rule
 (alias runtest)
 (action
  (diff opensuse-15.6.Dockerfile opensuse-15.6.Dockerfile.actual)))

(rule
 (alias runtest)
 (action
  (diff archlinux.Dockerfile archlinux.Dockerfile.actual)))
